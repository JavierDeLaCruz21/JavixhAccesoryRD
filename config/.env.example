# ==========================================
# Javich AccesoryShop - Variables de Entorno
# ==========================================
# Copia este archivo como .env en esta misma carpeta y asigna tus credenciales reales.
# NUNCA subas el archivo .env a Git o repositorio público.

# ------------------------------------------
# Aplicación y Entorno
# ------------------------------------------
APP_ENV=production
APP_URL=http://localhost/JavixhAccesoryRD

# ------------------------------------------
# Base de Datos MySQL
# ------------------------------------------
DB_HOST=localhost
DB_NAME=javich_shop
DB_USER=root
DB_PASS=

# ------------------------------------------
# Google OAuth 2.0 (Inicio de sesión con Google)
# ------------------------------------------
# Obtén estas credenciales en Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_google_client_secret

# ------------------------------------------
# Resend API (Envío de correos para restablecer contraseña)
# ------------------------------------------
# Obtén tu API Key en: https://resend.com
RESEND_API_KEY=re_tu_api_key_aqui
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=Javich AccesoryShop

# ------------------------------------------
# Seguridad y Tokens
# ------------------------------------------
# Tiempo de expiración del enlace de recuperación de contraseña (en horas)
RESET_TOKEN_EXPIRY_HOURS=1
